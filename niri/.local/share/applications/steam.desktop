[Desktop Entry]
Name=Steam
Comment=Application for managing and playing games on Steam
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam %U
Icon=steam
Terminal=false
Type=Application
Categories=Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=Store;Community;Library;Servers;Screenshots;News;Settings;BigPicture;Friends;
PrefersNonDefaultGPU=true

[Desktop Action Store]
Name=Store
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://store

[Desktop Action Community]
Name=Community
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://url/CommunityHome/

[Desktop Action Library]
Name=Library
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://open/games

[Desktop Action Servers]
Name=Servers
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://open/servers

[Desktop Action Screenshots]
Name=Screenshots
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://open/screenshots

[Desktop Action News]
Name=News
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://openurl/https://store.steampowered.com/news

[Desktop Action Settings]
Name=Settings
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://open/settings

[Desktop Action BigPicture]
Name=Big Picture
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://open/bigpicture

[Desktop Action Friends]
Name=Friends
Exec=/home/neo/.local/bin/niri-launch-on-workspace --app-id "(?i)steam|steamwebhelper" -- /usr/bin/steam steam://open/friends
